{
  "name": "@txt2sfx/agent",
  "version": "0.1.0",
  "type": "module",
  "description": "The LLM half of the pipeline: providers, the system prompt built from the live grammar tables, and the generate-validate-render-optimize loop. Zero runtime dependencies — providers speak HTTP through `fetch`.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/txt2sfx/txt2sfx.git",
    "directory": "packages/agent"
  },
  "homepage": "https://github.com/txt2sfx/txt2sfx/tree/main/packages/agent#readme",
  "bugs": "https://github.com/txt2sfx/txt2sfx/issues",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "tsc -b"
  },
  "dependencies": {
    "@txt2sfx/analyzer": "workspace:*",
    "@txt2sfx/core": "workspace:*",
    "@txt2sfx/optimizer": "workspace:*",
    "@txt2sfx/shared": "workspace:*"
  }
}
