{
  "name": "@txt2sfx/optimizer",
  "version": "0.1.0",
  "type": "module",
  "description": "Differential evolution over a soundline's `~value[min..max]` slots. Zero runtime dependencies.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/txt2sfx/txt2sfx.git",
    "directory": "packages/optimizer"
  },
  "homepage": "https://github.com/txt2sfx/txt2sfx/tree/main/packages/optimizer#readme",
  "bugs": "https://github.com/txt2sfx/txt2sfx/issues",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "tsc -b"
  },
  "dependencies": {
    "@txt2sfx/analyzer": "workspace:*",
    "@txt2sfx/core": "workspace:*",
    "@txt2sfx/shared": "workspace:*"
  }
}
