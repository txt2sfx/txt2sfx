# Copy to `.env` (git-ignored) or export these in your shell. Nothing in this
# repository ships a key, reads one from a checked-in file, or proxies a request
# through anyone else's service: the LLM is always yours.

# --- Language models -------------------------------------------------------
# Used by `pnpm bench -- --provider anthropic|gemini` and by any script that
# builds a provider from the environment. The playground does NOT read these:
# it takes a key pasted into the page, keeps it in tab memory, and sends it only
# in requests you started.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Recipe bank -----------------------------------------------------------
# Where the SQLite file lives. `:memory:` gives a throwaway bank, which is what
# the tests use.
TXT2SFX_DB=apps/server/data/recipes.db

# Loopback on purpose — a recipe bank on a laptop should not appear on the
# office network because someone ran `pnpm dev`. Set 0.0.0.0 deliberately.
HOST=127.0.0.1
PORT=8787
