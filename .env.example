# Copy to `.env` (git-ignored) or export these in your shell. Nothing in this
# repository ships a key, reads one from a checked-in file, or proxies a request
# through anyone else's service: the LLM is always yours.

# --- Language models -------------------------------------------------------
# Used by `pnpm bench -- --provider anthropic|gemini` and by any script that
# builds a provider from the environment. The playground does NOT read these:
# it takes a key pasted into the page, keeps it in tab memory, and sends it only
# in requests you started.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Recipe bank -----------------------------------------------------------
# Where the SQLite file lives. `:memory:` gives a throwaway bank, which is what
# the tests use.
TXT2SFX_DB=apps/server/data/recipes.db

# Loopback on purpose — a recipe bank on a laptop should not appear on the
# office network because someone ran `pnpm dev`. Set 0.0.0.0 deliberately.
HOST=127.0.0.1
PORT=8787

# --- Who may write to the bank ---------------------------------------------
# With no GitHub app configured the bank runs "solo": no sign-in, every write
# attributed to a built-in `local` account, and it refuses to bind anything but
# loopback in that state (an anonymous writable bank on a public interface is
# not a mode anybody chose on purpose — TXT2SFX_ALLOW_OPEN=1 overrides, loudly).
#
# The pair comes from an OAuth app at https://github.com/settings/developers
# whose callback is <PUBLIC_URL>/api/auth/github/callback. No scopes are
# requested: the token that comes back may read public profile data and nothing
# else, and it is used once and dropped rather than stored.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# The origin this bank answers on. The OAuth callback is derived from it, so it
# has to match what GitHub has registered exactly.
PUBLIC_URL=

# Origins a completed sign-in may hand a session back to, comma separated. An
# open redirect here is how a session ends up delivered to somebody else's page.
ALLOWED_ORIGINS=

# Unlocks /api/moderation/*. Unset, those routes are not registered at all — a
# default password is worse than a missing feature.
TXT2SFX_ADMIN_TOKEN=

# --- Connecting a Freesound account ----------------------------------------
# The Search tab looks for recordings on freesound.org with the *user's own*
# Freesound account, never with ours: their API terms (§4d) forbid answering for
# "end users that are not logged on to the Platform with valid user credentials
# and live session", which is what a shared application key would be.
#
# So this bank does exactly one thing in that flow — trade the OAuth2 `code` for
# a token, because that exchange is signed with a client secret that cannot ship
# to a browser. The tokens go straight back to the tab that asked; nothing here
# stores them and no account is needed to connect.
#
# The pair comes from an application at https://freesound.org/apiv2/apply/ whose
# redirect URI is <PUBLIC_URL>/api/freesound/callback. Unset, the routes report
# `enabled: false` and the tab says so instead of drawing a dead button.
FREESOUND_CLIENT_ID=
FREESOUND_CLIENT_SECRET=
